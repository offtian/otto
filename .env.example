# Copy to .env and fill in. .env is gitignored — never commit it.
# Every Settings field appears here (tests/unit/test_env_example.py enforces it).
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=dev
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/otto

# --- LLM gateway (app-side; compose `gateway` profile serves this in dev) ---
# Option A — LiteLLM gateway (parity with the firm proxy): `just stack`, then
#   LLM_MODEL=qwen3.6 (or gemma4, gpt-5.1) — see dev/litellm.yaml for the list.
#   qwen3.6 handles tool-calling far more reliably than gemma4 for the eval loop.
# Option B — talk to local Ollama directly (no gateway needed on the host):
#   LLM_BASE_URL=http://localhost:11434/v1 ; LLM_API_KEY=ollama ; LLM_MODEL=qwen3.6
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=dev
LLM_MODEL=gpt-5.1

# --- Slack app ---------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_TRIAGE_CHANNEL=

# --- Jira ticket channel (D9) — empty base URL = ticket channel disabled -----
JIRA_BASE_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_WEBHOOK_SECRET=

# Kill switch (FR8): false = ack Slack events but never reply. Env value is
# the default; a runtime_flags DB row overrides it live (just otto-off/on, C1).
OTTO_ENABLED=true
# Worst-case seconds between flipping the runtime flag and Otto going quiet.
KILL_SWITCH_CACHE_SECONDS=10

# Approver allowlists (D3) — comma-separated Slack user ids.
SUPPORT_USER_IDS=
ADMIN_USER_IDS=

# Max messages of conversation history rebuilt per event (D2).
THREAD_HISTORY_LIMIT=30

# Per-user Slack request cap per rolling minute (3.5); 0 disables.
SLACK_USER_RATE_LIMIT_PER_MINUTE=15

# Global Jira webhook dispatch cap per rolling minute (C2); 0 disables.
JIRA_EVENTS_PER_MINUTE=30

# --- Approval maintenance sweep (2.5) — set INTERVAL to 0 to disable ---------
APPROVAL_SWEEP_INTERVAL_MINUTES=15
APPROVAL_REMINDER_MINUTES=60
APPROVAL_EXPIRY_MINUTES=1440
APPROVAL_RETENTION_DAYS=30

# --- Telemetry (any subset) ---------------------------------------------------
OTEL_SERVICE_NAME=otto
OTLP_ENDPOINT=http://localhost:4318
LOGFIRE_TOKEN=
# Langfuse (`--profile langfuse`; keys match the compose headless init)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-otto-dev
LANGFUSE_SECRET_KEY=sk-lf-otto-dev

# --- MCP integrations (empty URL = capability runs on its local stub) --------
CONFLUENCE_MCP_URL=
CONFLUENCE_MCP_TOKEN=
# For the mock SailPoint server on the host set: http://localhost:9100/mcp
# (`docker compose --profile sailpoint up` or `uv run python dev/sailpoint_mock.py`).
SAILPOINT_MCP_URL=
SAILPOINT_MCP_TOKEN=

# --- Runbooks (relative paths resolve against the process cwd) ----------------
RUNBOOKS_DIR=runbooks

# User directory: cross-channel identity + team (see users.yaml for format).
USERS_FILE=users.yaml

# --- Secrets consumed by compose services (not by the app) -------------------
# litellm (gateway profile): upstream key for real model calls
OPENAI_API_KEY=
# mcp-confluence (mcp profile)
CONFLUENCE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=
