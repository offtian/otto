# Copy to .env and fill in. .env is gitignored — never commit it.
# Every Settings field appears here (tests/unit/test_env_example.py enforces it).
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=dev
DATABASE_URL=postgresql+asyncpg://localhost:5432/otto

# --- LLM gateway (app-side; compose `gateway` profile serves this in dev) ---
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=dev
LLM_MODEL=gpt-5.1

# --- Slack app ---------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_TRIAGE_CHANNEL=

# --- Jira ticket channel (D9) — empty base URL = ticket channel disabled -----
JIRA_BASE_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_WEBHOOK_SECRET=

# Kill switch (FR8): false = ack Slack events but never reply.
OTTO_ENABLED=true

# Approver allowlists (D3) — comma-separated Slack user ids.
SUPPORT_USER_IDS=
ADMIN_USER_IDS=

# Max messages of conversation history rebuilt per event (D2).
THREAD_HISTORY_LIMIT=30

# --- Telemetry (either, both, or neither) -------------------------------------
OTEL_SERVICE_NAME=otto
OTLP_ENDPOINT=http://localhost:4318
LOGFIRE_TOKEN=

# --- MCP integrations (empty URL = capability runs on its local stub) --------
CONFLUENCE_MCP_URL=
CONFLUENCE_MCP_TOKEN=
SAILPOINT_MCP_URL=
SAILPOINT_MCP_TOKEN=

# --- Runbooks (relative paths resolve against the process cwd) ----------------
RUNBOOKS_DIR=runbooks

# User directory: cross-channel identity + team (see users.yaml for format).
USERS_FILE=users.yaml

# --- Secrets consumed by compose services (not by the app) -------------------
# litellm (gateway profile): upstream key for real model calls
OPENAI_API_KEY=
# mcp-confluence (mcp profile)
CONFLUENCE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=
